# Sao chép thành .env.local khi chạy máy cá nhân. Trên Vercel: Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Khóa công khai: "anon" (legacy) hoặc "publishable" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ BÍ MẬT – chỉ đặt trên Vercel / .env.local, không commit lên GitHub
SUPABASE_SERVICE_ROLE_KEY=

# Địa chỉ website, không có dấu / ở cuối (dùng cho link đăng nhập HR và SEO)
NEXT_PUBLIC_SITE_URL=https://tuyendung.vioraliving.com.vn

# Chuỗi ngẫu nhiên dài (vd: openssl rand -hex 32)
IP_HASH_SALT=
# Vercel tự gửi kèm khi gọi Cron
CRON_SECRET=

# ===== Email tự động qua Microsoft 365 (xem docs/HUONG_DAN_EMAIL_MS365.md) =====
# Bỏ trống 4 biến đầu = không gửi email, website vẫn chạy bình thường.
MS365_TENANT_ID=
MS365_CLIENT_ID=
# ⚠️ BÍ MẬT – có hạn dùng, nhớ gia hạn trước khi hết hạn
MS365_CLIENT_SECRET=
# Hộp thư gửi đi (ứng viên trả lời email sẽ về hộp thư này)
MAIL_FROM=hr@vioraliving.com.vn
# Email HR nhận thông báo khi có hồ sơ mới, nhiều email cách nhau dấu phẩy. Bỏ trống = không báo HR.
HR_NOTIFY_TO=hr@vioraliving.com.vn
